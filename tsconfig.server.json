{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "paths": { "@/*": ["./src/*.ts"] }
  },
  "include": ["server/**/*.js", "server/**/*.ts", "scripts/drive-connect.mjs", "scripts/*.test.ts"]
}
